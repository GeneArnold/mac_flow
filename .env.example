# Copy this file to `.env` and fill in only the keys for providers you use.
#
# The default setup is fully LOCAL and needs NO keys:
#   transcription.provider = "mlx"     (local Whisper, downloaded on first run)
#   enhancement.provider    = "ollama" (local LLM at http://localhost:11434)
#
# Add a key below only if you switch that step to a cloud provider in
# mac_flow.toml (transcription.provider / enhancement.provider):

# Groq — used if transcription.provider = "groq" or enhancement.provider = "groq".
# Get a free key at https://console.groq.com.
GROQ_API_KEY="gsk_your_key_here"

# DeepSeek — used if enhancement.provider = "deepseek".
# Get a key at https://platform.deepseek.com.
DEEPSEEK_API_KEY="sk_your_key_here"

# OpenRouter — used if enhancement.provider = "openrouter".
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY="sk-or-your_key_here"
